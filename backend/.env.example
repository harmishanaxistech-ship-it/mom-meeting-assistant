PORT=5001
NODE_ENV=development

# ================================================================
# TOGGLE BETWEEN LOCAL AND LIVE MONGODB:
# Set USE_LOCAL_DB=true  -> Uses local MongoDB (for local testing)
# Set USE_LOCAL_DB=false -> Uses MongoDB Atlas (for live server)
# ================================================================
USE_LOCAL_DB=true
MONGODB_LOCAL_URI=mongodb://localhost:27017/mom_assistant
MONGODB_LIVE_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mom_assistant?retryWrites=true&w=majority
JWT_SECRET=super_secret_jwt_key_for_mom_assistant_2026_mvp_change_in_prod
JWT_EXPIRES_IN=7d

# Static User Credentials for MVP (Section 27)
STATIC_USER_EMAIL=user@momassistant.com
STATIC_USER_PASSWORD=Password123!
STATIC_USER_NAME=Demo User

# Provider Configurations (Mock by default per Section 31 & 32)
STT_PROVIDER=openai
AI_PROVIDER=openai
TRANSLATION_PROVIDER=openai

# ================================================================
# TOGGLE BETWEEN OPENAI AND GROQ:
# Set USE_GROQ=false to use OpenAI Live Key (gpt-4o-mini)
# Set USE_GROQ=true to use Free Groq Key (openai/gpt-oss-120b)
# ================================================================
USE_GROQ=false

# Third Party API Keys
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Uploads directory
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=150

# Master list of all possible attendees to automatically calculate 'Absentees' in MOM exports
TEAM_MEMBERS=Alex,John,Sarah,Harmish,Admin

